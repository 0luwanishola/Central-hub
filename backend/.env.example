# Central Hub backend configuration. Copy to backend/.env and fill in what you
# need; every value is optional, and unset features stay disabled rather than
# falling back to secrets.
#
# The repo root .env is read too (backend/main.py loads both).

# Browser origins allowed to call the API, comma separated.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# SQL Scratch: root directory for disposable workspace files. Defaults to the
# system temp directory (central_hub/sql_scratch). The server owns this
# directory and wipes it on startup, so point it at a dedicated temp path only.
# CQ_SCRATCH_SQL_ROOT=

# LiveScore: when set, API-Football is preferred over ESPN.
API_FOOTBALL_KEY=
